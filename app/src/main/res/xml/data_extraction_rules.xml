<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (API 31+). AI API keys stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="simpletype_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="simpletype_ai.xml" />
    </device-transfer>
</data-extraction-rules>
